device Cs43131 {
    register-address-type: u32,
    default-byte-order: LE,
    default-access: RW,

    block Global {
        address-offset: 0,
        register DeviceID {
            address: 0x10000,
            access: RO,
            fields: fieldset _ {
                // askip ca auto-incremente, on verra bien
                size-bytes: 3,
                field dev_id 23:0,
            },
        },

        register PowerDownControl {
            address: 0x20000,
            fields: fieldset _ {
                size-bytes: 1,
                field PDN_CLKOUT 1,
                field PDN_PLL 2,
                field PDN_XTAL 3,
                field PDN_HP 4,
                field PDN_DSDIF 5,
                field PDN_ASP 6,
                field PDN_XSP 7,
            },
        },
    },

    block Interrupts {
        address-offset: 0,
        register Status1 {
            address: 0xF0000,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,
                field PLL_DONE 0,
                field PLL_ERROR 1,
                field PLL_READY 2,

                field XTAL_ERROR 3,
                field XTAL_READY 4,
                field HP_DETECT_UNPLUG 5,
                field HP_DETECT_PLUG 6,
                field DAC_OVFL 7,
            },
        },
        register Status2 {
            address: 0xF0001,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,
                field ASP_NOLRCK 3,
                field ASP_EARLY 4,
                field ASP_LATE 5,
                field ASP_ERROR 6,
                field ASP_OVFL 7,
            },
        },
    },

    block InterruptMasks {
        // Mask = 1 means interrupt is disabled
        address-offset: 0,
        register Mask1 {
            address: 0xF0010,
            fields: fieldset _ {
                size-bytes: 1,
                field PLL_DONE 0,
                field PLL_ERROR 1,
                field PLL_READY 2,

                field XTAL_ERROR 3,
                field XTAL_READY 4,
                field HP_DETECT_UNPLUG 5,
                field HP_DETECT_PLUG 6,
                field DAC_OVFL 7,
            },
        },
        register Mask2 {
            address: 0xF0011,
            fields: fieldset _ {
                size-bytes: 1,
                field ASP_NOLRCK 3,
                field ASP_EARLY 4,
                field ASP_LATE 5,
                field ASP_ERROR 6,
                field ASP_OVFL 7,
            },
        },
    }
}
